{:paths ["src" "resources"]

 :deps
 {org.clojure/clojure {:mvn/version "1.12.6"}
  ;; JVM: reads the schemas, and inlines them into CLJS builds
  org.clojure/data.json {:mvn/version "2.5.2"}
  frankiesardo/linked {:mvn/version "1.3.0"}}

 :aliases
 {:test
  {:extra-paths ["test"]
   :extra-deps {org.clojure/test.check {:mvn/version "1.1.3"}
                io.github.cognitect-labs/test-runner {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
   :main-opts ["-m" "cognitect.test-runner"]
   :exec-fn cognitect.test-runner.api/test}

  :cljs
  {:extra-paths ["test"]
   :extra-deps {org.clojure/clojurescript {:mvn/version "1.12.145"}
                org.clojure/test.check {:mvn/version "1.1.3"}
                thheller/shadow-cljs {:mvn/version "3.5.3"}}
   :main-opts ["-m" "shadow.cljs.devtools.cli"]}

  :lint
  {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2026.08.04"}}
   :main-opts ["-m" "clj-kondo.main"]}

  :fmt
  {:replace-deps {dev.weavejester/cljfmt {:mvn/version "0.16.6"}}
   :main-opts ["-m" "cljfmt.main"]}}}
