{:tasks
 {test:jvm
  {:doc "JVM tests. Optional namespaces: bb test:jvm lexer processor"
   :task (apply shell "clojure" "-M:test"
                (mapcat (fn [n] ["-n" (str "tokenscript." n "-test")]) *command-line-args*))}

  test:cljs
  {:doc "ClojureScript tests on node"
   :task (do (shell "clojure" "-M:cljs" "compile" "test")
             (shell "node" "target/tests/test.js"))}

  test
  {:doc "JVM and ClojureScript tests"
   :depends [test:jvm test:cljs]}

  lint
  {:doc "clj-kondo and cljfmt check"
   :task (do (shell "clojure" "-M:lint" "--fail-level" "warning" "--lint" "src" "test")
             (shell "clojure" "-M:fmt" "check" "src" "test"))}

  fmt
  {:doc "cljfmt fix"
   :task (shell "clojure" "-M:fmt" "fix" "src" "test")}}}
