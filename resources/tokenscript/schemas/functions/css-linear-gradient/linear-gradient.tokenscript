// CSS linear-gradient()
// https://www.w3.org/TR/css-images-3/#linear-gradients
//
//   linear-gradient(to right, #f00, #00f)
//   linear-gradient(90deg, #f00 0%, {color.brand} 50% 80%, #00f 100%)
//   linear-gradient(0.25turn, #f00, #00f)
//
// The first argument is the direction when it is `to` and one or two
// sides, or an angle in `deg`, `grad`, `rad` or `turn`. Without one the
// gradient goes `to bottom`. A stop is a color, followed by one position
// in percent, or two for two stops of the same color. A lone percentage
// is a color hint and is left out. Stops without a position get the one
// CSS gives them: the first is at 0%, the last at 100% and the stops in
// between are spread evenly between the stops around them. Positions are
// clamped to 0%-100%.
//
// Returns the value of a gradient token (see the `gradient` token type):
// a Dictionary with `kind`, `angle` in degrees and `stops`, each a
// Dictionary with a `color` and a `position` from 0 to 1. Arguments that
// are none of the above return null.
//
// Input:  List of arguments
// Output: Dictionary

variable args: List = {input};

variable angle: Number = 180;
variable first_stop: Number = 0;
variable has_top: Boolean = false;
variable has_right: Boolean = false;
variable has_bottom: Boolean = false;
variable has_left: Boolean = false;
variable word: String = "";
variable valid: Boolean = true;

// The direction
if (type(args.get(0)) == "deg") [
  angle = args.get(0).to_number();
  first_stop = 1;
] elif (is_list(args.get(0))) [
  if (type(args.get(0).get(0)) == "string") [
    if (args.get(0).get(0).lower() == "to") [
      first_stop = 1;
      for side in args.get(0) [
        if (type(side) == "string") [
          word = side.lower();
          if (word == "top") [ has_top = true; ];
          if (word == "right") [ has_right = true; ];
          if (word == "bottom") [ has_bottom = true; ];
          if (word == "left") [ has_left = true; ];
        ];
      ];
      if (has_top && has_right) [
        angle = 45;
      ] elif (has_bottom && has_right) [
        angle = 135;
      ] elif (has_bottom && has_left) [
        angle = 225;
      ] elif (has_top && has_left) [
        angle = 315;
      ] elif (has_top) [
        angle = 0;
      ] elif (has_right) [
        angle = 90;
      ] elif (has_bottom) [
        angle = 180;
      ] elif (has_left) [
        angle = 270;
      ] else [
        valid = false;
      ];
    ];
  ] elif (args.get(0).length() == 2 && type(args.get(0).get(1)) == "string") [
    word = args.get(0).get(1).lower();
    if (word == "turn") [
      angle = args.get(0).get(0) * 360;
      first_stop = 1;
    ] elif (word == "grad") [
      angle = args.get(0).get(0) * 0.9;
      first_stop = 1;
    ] elif (word == "rad") [
      angle = args.get(0).get(0) * 180 / 3.141592653589793;
      first_stop = 1;
    ];
  ];
];

// The stops. A position that is not known yet is -1.
variable colors: List = [];
variable positions: List = [];

for arg_index in range(first_stop, args.length()) [
  if (is_color(args.get(arg_index))) [
    colors.append(args.get(arg_index));
    positions.append(-1);
  ] elif (is_list(args.get(arg_index))) [
    if (is_color(args.get(arg_index).get(0)) && args.get(arg_index).length() <= 3) [
      for part_index in range(1, args.get(arg_index).length()) [
        if (type(args.get(arg_index).get(part_index)) == "%") [
          colors.append(args.get(arg_index).get(0));
          positions.append(args.get(arg_index).get(part_index).to_number());
        ] else [
          valid = false;
        ];
      ];
    ] else [
      valid = false;
    ];
  ] elif (type(args.get(arg_index)) != "%") [
    valid = false;
  ];
];

variable count: Number = colors.length();
if (count < 2) [
  valid = false;
];

// Every run of stops without a position is spread between the stops
// around it
variable last: Number = count - 1;
variable index: Number = 1;
variable run_end: Number = 0;
variable cursor: Number = 0;
variable from: Number = 0;
variable to: Number = 0;

if (valid) [
  if (positions.get(0) < 0) [
    positions.update(0, 0);
  ];
  if (positions.get(last) < 0) [
    positions.update(last, 100);
  ];
  while (index < last) [
    if (positions.get(index) < 0) [
      run_end = index;
      while (positions.get(run_end) < 0) [
        run_end = run_end + 1;
      ];
      from = positions.get(index - 1);
      to = positions.get(run_end);
      cursor = index;
      while (cursor < run_end) [
        positions.update(cursor, from + (to - from) * (cursor - index + 1) / (run_end - index + 1));
        cursor = cursor + 1;
      ];
      index = run_end;
    ];
    index = index + 1;
  ];
];

variable output: Dictionary;
variable stops: List = [];
variable stop: Dictionary;

if (valid) [
  for stop_index in range(0, count) [
    stop.clear();
    stop.set("color", colors.get(stop_index));
    stop.set("position", round(min(max(positions.get(stop_index), 0), 100) * 100) / 10000);
    stops.append(stop);
  ];
  output.set("kind", "linear");
  output.set("angle", angle);
  output.set("stops", stops);
  return output;
];

return null;
